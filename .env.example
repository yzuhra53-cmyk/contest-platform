# Copy to .env locally and replace the placeholders.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=Zuhra
# Majburiy: bo'sh qolsa, har ishga tushishda konsolga vaqtinchalik parol chiqariladi.
ADMIN_PASSWORD=replace-with-a-strong-password
DATABASE_URL=sqlite:///contest.db
FLASK_DEBUG=false
# Ichki judge sozlamalari (ixtiyoriy)
JUDGE_TIME_LIMIT=2
JUDGE_MEMORY_MB=256
JUDGE_MAX_PARALLEL=2
# Ekrandagi va formalardagi vaqt mintaqasi (Toshkent = 5)
APP_UTC_OFFSET_HOURS=5
# Safe Exam Browser: SEB Config Tool'dagi Config Key (bir nechta bo'lsa vergul bilan)
SEB_CONFIG_KEYS=
# Ixtiyoriy: talabaga ko'rsatiladigan sebs://... havola (.seb konfiguratsiya fayliga)
SEB_START_LINK=
# Kamera kadrlari va hodisalar necha kundan keyin o'chiriladi
PROCTOR_RETENTION_DAYS=30
# Bitta talabaning ketma-ket yechimlari orasidagi minimal oraliq (soniya)
SUBMIT_COOLDOWN_SECONDS=20
